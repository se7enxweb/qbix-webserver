# Runtime state — created by the server, never committed
files/
local/
tests/local/
# Mesh identity keypair (private key) — generated on first run, never committed
keys/

# Build artifacts
# bin/qbixserver.phar is NOT here: it is tracked, it is what a Composer install
# runs, and listing it made local rebuilds look like noise instead of the change
# they are. tests/phar-is-current.php checks it against its sources.
qbixserver.phar
node_modules/

# Editor / OS
.DS_Store
*.swp
*~

# Compiled binary only — bin/uwebserver.c and bin/u_*.h are SOURCE and tracked
bin/uwebserver
bin/qbixserver
qbixserver-linux-*
qbixserver-macos-*
qbixserver-windows-*
qbix-build.php
