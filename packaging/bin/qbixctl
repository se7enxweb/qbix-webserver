#!/usr/bin/env sh
# qbixctl, as installed by the packages and the container image.
# QBIX_HOME is where they put the server (default /usr/share/exponential-velocity);
# PHP is the interpreter (default: php on PATH).
QBIX_HOME="${QBIX_HOME:-/usr/share/exponential-velocity}"
exec "${PHP:-php}" "$QBIX_HOME/qbixctl.php" "$@"
